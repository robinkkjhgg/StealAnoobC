local BtnAntiSteal = createButton("🛡️ Anti-Roubo Auto-Bat (OFF)", Color3.fromRGB(60, 60, 75))

local function equipAndUseBat()
	local char = LocalPlayer.Character
	if not char then return nil end
	
	local bat = char:FindFirstChild("Bat") or LocalPlayer.Backpack:FindFirstChild("Bat")
	if bat then
		if bat.Parent == LocalPlayer.Backpack then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:EquipTool(bat)
			end
		end
		bat:Activate()
		return bat
	end
	return nil
end

BtnAntiSteal.MouseButton1Click:Connect(function()
	antiStealEnabled = not antiStealEnabled
	if antiStealEnabled then
		BtnAntiSteal.Text = "🛡️ Anti-Roubo Auto-Bat (ON)"
		BtnAntiSteal.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
		
		antiStealConnection = RunService.Heartbeat:Connect(function()
			if not antiStealEnabled then return end
			
			local myBase = getPlayerBase(LocalPlayer)
			local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not myBase or not myHrp then return end
			
			local collectPart = myBase:FindFirstChild("CollectZone", true) or myBase:FindFirstChild("Spawn", true)
			if not collectPart then return end
			
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local enemyHrp = p.Character.HumanoidRootPart
					local dist = (enemyHrp.Position - collectPart.Position).Magnitude
					
					if dist < 20 then
						equipAndUseBat()
						myHrp.CFrame = enemyHrp.CFrame * CFrame.new(0, 0, 1)
						
						local vel = myHrp.Velocity
						myHrp.Velocity = Vector3.new(10000, 10000, 10000)
						RunService.RenderStepped:Wait()
						myHrp.Velocity = vel
					end
				end
			end
		end)
	else
		BtnAntiSteal.Text = "🛡️ Anti-Roubo Auto-Bat (OFF)"
		BtnAntiSteal.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		if antiStealConnection then
			antiStealConnection:Disconnect()
			antiStealConnection = nil
		end
	end
end)

