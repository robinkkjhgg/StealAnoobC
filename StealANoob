-- 1. TELEPORTAR PARA BASE
local function teleportToMyBase()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        showNotification("❌ Personagem não encontrado!", true)
        return
    end

    if not isHoldingThing() then
        showNotification("❌ Você precisa estar segurando 1 Thing!", true)
        return
    end

    local myBase = getPlayerBase(LocalPlayer)
    
    if myBase then
        local dest = myBase:FindFirstChild("CollectZone", true) or 
                     myBase:FindFirstChild("Spawn", true) or 
                     myBase:FindFirstChild("SpawnLocation", true) or
                     myBase.PrimaryPart
        
        if dest then
            if dest:IsA("Model") then
                dest = dest.PrimaryPart or dest:FindFirstChildWhichIsA("BasePart")
            end
            
            if dest and dest:IsA("BasePart") then
                hrp.CFrame = dest.CFrame + Vector3.new(0, 4, 0)
                showNotification("✅ Teleportado para sua base!", false)
                return
            end
        end
        
        local baseHRP = myBase:FindFirstChild("HumanoidRootPart") or myBase:FindFirstChildWhichIsA("BasePart")
        if baseHRP then
            hrp.CFrame = baseHRP.CFrame + Vector3.new(0, 4, 0)
            showNotification("✅ Teleportado para sua base!", false)
            return
        end
        
        showNotification("❌ Ponto de teleporte não encontrado!", true)
    else
        showNotification("❌ Sua base não foi encontrada!", true)
    end
end

-- 2. ANTI-RAGDOLL
local antiRagdollEnabled = false
local antiRagdollConnection = nil

local function applyAntiRagdoll()
    if antiRagdollConnection then antiRagdollConnection:Disconnect() end
    
    antiRagdollConnection = RunService.Heartbeat:Connect(function()
        if not antiRagdollEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            if hum.PlatformStand then hum.PlatformStand = false end
        end
        
        for _, inst in ipairs(char:GetDescendants()) do
            if inst.Name == "RagdollConstraint" or inst.Name == "ColliderPart" then
                inst:Destroy()
            elseif inst:IsA("Motor6D") and not inst.Enabled then
                inst.Enabled = true
            end
        end
    end)
end

-- 3. ESP THINGS
local espThingsEnabled = false
local espThingsFolder = Instance.new("Folder", Workspace)
espThingsFolder.Name = "ThingsESP"

local function clearESPNasBases()
    espThingsFolder:ClearAllChildren()
end

local function updateThingsESP()
    clearESPNasBases()
    if not espThingsEnabled then return end
    
    local mapBases = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Bases") or Workspace:FindFirstChild("Bases")
    if not mapBases then return end
    
    for _, base in ipairs(mapBases:GetChildren()) do
        for _, desc in ipairs(base:GetDescendants()) do
            if desc:IsA("Model") and (desc.Parent and desc.Parent.Name == "Slots" or desc:FindFirstChild("Configuration")) then
                local cfg = desc:FindFirstChild("Configuration")
                if cfg then
                    local thingVal = cfg:FindFirstChild("Thing") and cfg.Thing.Value
                    if thingVal and typeof(thingVal) == "Instance" then
                        local targetPart = thingVal.PrimaryPart or desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "ThingsESP"
                            billboard.AlwaysOnTop = true
                            billboard.Size = UDim2.new(0, 200, 0, 40)
                            billboard.Adornee = targetPart
                            billboard.Parent = espThingsFolder
                            
                            local textFrame = Instance.new("TextLabel")
                            textFrame.Size = UDim2.new(1, 0, 1, 0)
                            textFrame.BackgroundTransparency = 1
                            textFrame.TextColor3 = Color3.fromRGB(255, 230, 100)
                            textFrame.TextStrokeTransparency = 0
                            textFrame.Font = Enum.Font.SourceSansBold
                            textFrame.TextSize = 13
                            
                            local rarity = cfg:FindFirstChild("Rarity") and cfg.Rarity.Value or "Comum"
                            local mutation = cfg:FindFirstChild("Mutation") and cfg.Mutation.Value or ""
                            
                            local details = "📦 " .. thingVal.Name .. " | ⭐ " .. tostring(rarity)
                            if mutation ~= "" and mutation ~= "Nenhuma" then
                                details = details .. " | 🧬 " .. tostring(mutation)
                            end
                            
                            textFrame.Text = details
                            textFrame.Parent = billboard
                        end
                    end
                end
            end
        end
    end
end

