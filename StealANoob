-- HELPER: ENCONTRAR BASE DO PLAYER
---------------------------------------------------------
local function getPlayerBase(player)
	local mapBases = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Bases") or Workspace:FindFirstChild("Bases")
	if mapBases then
		for _, base in ipairs(mapBases:GetChildren()) do
			local cfg = base:FindFirstChild("Configuration")
			local pVal = cfg and cfg:FindFirstChild("Player")
			if pVal and pVal.Value == player then
				return base
			end
		end
	end
	return nil
end

