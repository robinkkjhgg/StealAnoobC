---------------------------------------------------------
local BtnESP = createButton("👁️ ESP Things Nas Bases (OFF)", nil, true)
local espFolder = Instance.new("Folder", Workspace)
espFolder.Name = "ThingsESP_BasesOnly"

local function clearESP()
	espFolder:ClearAllChildren()
end

local function updateThingsESP()
	clearESP()
	if not espEnabled or not isPremium then return end
	
	local mapBases = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Bases") or Workspace:FindFirstChild("Bases")
	if not mapBases then return end
	
	for _, base in ipairs(mapBases:GetChildren()) do
		for _, desc in ipairs(base:GetDescendants()) do
			if desc:IsA("Model") and (desc.Parent and desc.Parent.Name == "Slots" or desc:FindFirstChild("Configuration")) then
				local cfg = desc:FindFirstChild("Configuration")
				if cfg then
					local thingVal = cfg:FindFirstChild("Thing") and cfg.Thing.Value
					
					if thingVal and typeof(thingVal) == "Instance" then
						local name = thingVal.Name
						local mutation = cfg:FindFirstChild("Mutation") and cfg.Mutation.Value or "Nenhuma"
						local rarity = cfg:FindFirstChild("Rarity") and cfg.Rarity.Value or cfg:FindFirstChild("RebirthRequired") and ("Rebirth " .. tostring(cfg.RebirthRequired.Value)) or "Comum"
						local incomeGen = cfg:FindFirstChild("Income") and cfg.Income.Value or cfg:FindFirstChild("Multiplier") and (tostring(cfg.Multiplier.Value) .. "x") or "1x"
						
						local targetPart = thingVal.PrimaryPart or desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")
						
						if targetPart then
							local billboard = Instance.new("BillboardGui")
							billboard.Name = "ThingsESP"
							billboard.AlwaysOnTop = true
							billboard.Size = UDim2.new(0, 200, 0, 45)
							billboard.Adornee = targetPart
							billboard.Parent = espFolder
							
							local textFrame = Instance.new("TextLabel")
							textFrame.Size = UDim2.new(1, 0, 1, 0)
							textFrame.BackgroundTransparency = 1
							textFrame.TextColor3 = Color3.fromRGB(255, 230, 100)
							textFrame.TextStrokeTransparency = 0
							textFrame.Font = Enum.Font.SourceSansBold
							textFrame.TextSize = 13
							
							local details = string.format("📦 %s\n⭐ Raridade: %s | 💰 Gera: %s", name, tostring(rarity), tostring(incomeGen))
							if mutation ~= "Nenhuma" and mutation ~= "" then
								details = details .. "\n🧬 Mutação: " .. tostring(mutation)
							end
							
							textFrame.Text = details
							textFrame.Parent = billboard
						end
					end
				end
			end
		end
	end
end

BtnESP.MouseButton1Click:Connect(function()
	if not promptPremium() then return end
	
	espEnabled = not espEnabled
	sendWebhook("FEATURE_USE", "ESP Things: " .. (espEnabled and "ATIVADO" or "DESATIVADO"))
	if espEnabled then
		BtnESP.Text = isPremium and "👑 👁️ ESP Things Nas Bases (ON)" or "👁️ ESP Things Nas Bases (ON)"
		BtnESP.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
		task.spawn(function()
			while espEnabled and isPremium do
				updateThingsESP()
				task.wait(3)
			end
		end)
	else
		BtnESP.Text = isPremium and "👑 👁️ ESP Things Nas Bases (OFF)" or "🔒 👁️ ESP Things Nas Bases [PREMIUM]"
		BtnESP.BackgroundColor3 = isPremium and Color3.fromRGB(55, 45, 25) or Color3.fromRGB(60, 60, 75)
		clearESP()
	end
end)

