-- Sistema de notificações (mantido igual)
local NotificationGui = Instance.new("ScreenGui")
NotificationGui.Name = "StealNotificationGui"
NotificationGui.ResetOnSpawn = false
NotificationGui.DisplayOrder = 999999
NotificationGui.Parent = parentTarget

local function showNotification(message, isError)
    local notifyFrame = Instance.new("Frame")
    notifyFrame.Size = UDim2.new(0, 350, 0, 50)
    notifyFrame.Position = UDim2.new(0.5, -175, 0.15, 0)
    notifyFrame.BackgroundColor3 = isError and Color3.fromRGB(45, 15, 15) or Color3.fromRGB(15, 45, 15)
    notifyFrame.BorderSizePixel = 0
    notifyFrame.Parent = NotificationGui
    Instance.new("UICorner", notifyFrame).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = isError and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 255, 60)
    stroke.Parent = notifyFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Text = message
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.TextWrapped = true
    label.BackgroundTransparency = 1
    label.Parent = notifyFrame

    task.delay(3, function()
        if notifyFrame and notifyFrame.Parent then
            notifyFrame:Destroy()
        end
    end)
