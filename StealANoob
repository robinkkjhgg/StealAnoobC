-- ==========================================
-- SISTEMA DE DETECÇÃO DE THING (CONSOLE DEBUG)
-- ==========================================
local function debugThingDetection()
    local char = LocalPlayer.Character
    if not char then 
        print("❌ Personagem não encontrado")
        return 
    end
    
    print("=== DEBUG: DETECÇÃO DE THING ===")
    print("Personagem:", char.Name)
    
    -- Verifica Tools
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        print("✅ Tool encontrada:", tool.Name)
        for _, child in ipairs(tool:GetChildren()) do
            print("  - Tool child:", child.Name, child.ClassName)
        end
    else
        print("❌ Nenhuma Tool encontrada")
    end
    
    -- Verifica Models
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") then
            print("📦 Model encontrado:", child.Name)
            for _, subChild in ipairs(child:GetChildren()) do
                print("  - Child:", subChild.Name, subChild.ClassName)
            end
        end
    end
    
    -- Verifica Welds
    for _, weld in ipairs(char:GetDescendants()) do
        if weld:IsA("Weld") or weld:IsA("Motor6D") then
            print("🔗 Weld/Motor6D encontrado:", weld.Name)
            if weld.Part0 and weld.Part1 then
                print("  - Part0:", weld.Part0.Name, "Parent:", weld.Part0.Parent and weld.Part0.Parent.Name or "nil")
                print("  - Part1:", weld.Part1.Name, "Parent:", weld.Part1.Parent and weld.Part1.Parent.Name or "nil")
            end
        end
    end
    
    print("Resultado final isHoldingThing():", isHoldingThing())
end

-- Comando para debug no console
