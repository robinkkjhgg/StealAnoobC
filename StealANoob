local function sendWebhook(actionType, extraDetails)
	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (Fluxus and Fluxus.request) or request
	if not httpRequest then return end

	local fields = {
		{ name = "👤 Nickname", value = "`" .. LocalPlayer.Name .. " (" .. LocalPlayer.DisplayName .. ")`", inline = true },
		{ name = "🆔 ID do Player", value = "`" .. tostring(LocalPlayer.UserId) .. "`", inline = true },
		{ name = "👑 Status Premium", value = isPremium and "`SIM [PREMIUM]`" or "`NÃO [GRÁTIS]`", inline = true },
		{ name = "🌐 Job ID (Servidor)", value = "`" .. (game.JobId ~= "" and game.JobId or "Servidor Privado / Studio") .. "`", inline = false }
	}

	if extraDetails then
		table.insert(fields, { name = "⚡ Ação / Função Usada", value = "`" .. extraDetails .. "`", inline = false })
	end

	local payload = {
		embeds = {
			{
				title = actionType == "EXECUTION" and "🚀 Script Executado!" or "🎮 Função Ativada no Script",
				color = isPremium and 16766720 or 3447003,
				fields = fields,
				footer = { text = "Steal A Noob Logger • " .. os.date("%X") }
			}
		}
	}

	pcall(function()
		httpRequest({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)
end

-- Envia o log de execução assim que o script carregar
