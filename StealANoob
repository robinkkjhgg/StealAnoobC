local function listAllThings()
    local mapBases = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Bases") or Workspace:FindFirstChild("Bases")
    if not mapBases then
        showNotification("❌ Bases não encontradas!", true)
        return
    end
    
    local things = {}
    for _, base in ipairs(mapBases:GetChildren()) do
        for _, desc in ipairs(base:GetDescendants()) do
            if desc:IsA("Model") and desc:FindFirstChild("Configuration") then
                local cfg = desc.Configuration
                local thingVal = cfg:FindFirstChild("Thing") and cfg.Thing.Value
                if thingVal and typeof(thingVal) == "Instance" then
                    local rarity = cfg:FindFirstChild("Rarity") and cfg.Rarity.Value or "Comum"
                    local mutation = cfg:FindFirstChild("Mutation") and cfg.Mutation.Value or ""
                    local owner = cfg:FindFirstChild("Player") and cfg.Player.Value or "Sem dono"
                    
                    local info = string.format("📦 %s | ⭐%s | 👤%s", thingVal.Name, rarity, owner.Name or "Sem dono")
                    if mutation ~= "" and mutation ~= "Nenhuma" then
                        info = info .. " | 🧬" .. mutation
                    end
                    table.insert(things, info)
                end
            end
        end
    end
    
    if #things > 0 then
        print("=== THINGS ENCONTRADAS ===")
        for _, thing in ipairs(things) do
            print(thing)
        end
        showNotification(string.format("✅ %d Things encontradas! Veja no console (F9)", #things), false)
    else
        showNotification("❌ Nenhuma Thing encontrada!", true)
    end
end

