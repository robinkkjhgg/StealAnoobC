-- ==========================================
-- STEAL A NOOB - SCRIPT CORRIGIDO (DETECÇÃO DE THING MELHORADA)
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local parentTarget = game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- ==========================================
-- FUNÇÃO MELHORADA PARA DETECTAR THING
-- ==========================================
local function isHoldingThing()
    local char = LocalPlayer.Character
    if not char then return false end

    -- 1. Verifica se tem uma Tool equipada (mais comum)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        -- Verifica se a Tool tem alguma referência a uma Thing
        if tool:FindFirstChild("Configuration") or 
           tool:FindFirstChild("Thing") or 
           tool:FindFirstChild("Rarity") or
           tool:FindFirstChild("ThingData") then
            return true
        end
    end

    -- 2. Verifica se há algum modelo com Configuration (Things geralmente são Models)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") then
            -- Verifica se é uma Thing por várias propriedades
            if child:FindFirstChild("Configuration") or 
               child:FindFirstChild("Thing") or 
               child:FindFirstChild("Rarity") or
               child:FindFirstChild("ThingData") or
               child.Name:lower():find("thing") or
               child:FindFirstChild("ThingAttachment") then
                return true
            end
            
            -- Verifica se o modelo tem um PrimaryPart com attachments
            local primaryPart = child.PrimaryPart
            if primaryPart then
                for _, attach in ipairs(primaryPart:GetChildren()) do
                    if attach:IsA("Attachment") and 
                       (attach.Name:lower():find("thing") or 
                        attach:FindFirstChild("ThingGui") or
                        attach:FindFirstChild("Stolen")) then
                        return true
                    end
                end
            end
        end
        
        -- 3. Verifica se há partes com referências a Thing
        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
            if child:FindFirstChild("ThingAttachment") or
               child:FindFirstChild("ThingGui") or
               child:FindFirstChild("Configuration") then
                return true
            end
        end
    end

    -- 4. Verifica através de ProximityPrompts (se estiver interagindo com uma)
    for _, prompt in ipairs(char:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            while parent do
                if parent:IsA("Model") and 
                   (parent:FindFirstChild("Configuration") or 
                    parent:FindFirstChild("Thing") or
                    parent:FindFirstChild("Rarity") or
                    parent.Name:lower():find("thing")) then
                    return true
                end
                parent = parent.Parent
            end
        end
    end

    -- 5. Verifica no Workspace se o jogador está segurando algo (via Weld/Motor6D)
    for _, weld in ipairs(char:GetDescendants()) do
        if weld:IsA("Weld") or weld:IsA("Motor6D") then
            local part0 = weld.Part0
            local part1 = weld.Part1
            
            -- Se uma parte está conectada ao personagem e parece ser uma Thing
            if part0 and part1 then
                for _, part in ipairs({part0, part1}) do
                    if part.Parent and part.Parent ~= char and part.Parent:IsA("Model") then
                        local model = part.Parent
                        if model:FindFirstChild("Configuration") or 
                           model:FindFirstChild("Thing") or
                           model:FindFirstChild("Rarity") then
                            return true
                        end
                    end
                end
            end
        end
    end

    return false
end

-- ==========================================
-- FUNÇÃO PARA ENCONTRAR A BASE DO PLAYER
-- ==========================================
local function getPlayerBase(player)
    local mapBases = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Bases") or Workspace:FindFirstChild("Bases")
    if mapBases then
        for _, base in ipairs(mapBases:GetChildren()) do
            local cfg = base:FindFirstChild("Configuration")
            local pVal = cfg and cfg:FindFirstChild("Player")
            if pVal and pVal.Value == player then
                return base
            end
        end
    end
    return nil
end

-- ==========================================
-- FUNÇÃO DE TELEPORTE CORRIGIDA
-- ==========================================
local function teleportToMyBase()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        showNotification("❌ Personagem não encontrado!", true)
        return
    end

    -- Verifica se está segurando uma Thing usando a função melhorada
    if not isHoldingThing() then
        showNotification("❌ Você precisa estar segurando 1 Thing para se teleportar!", true)
        return
    end

    local myBase = getPlayerBase(LocalPlayer)
    
    if myBase then
        -- Tenta encontrar um ponto de teleporte na base
        local dest = myBase:FindFirstChild("CollectZone", true) or 
                     myBase:FindFirstChild("Spawn", true) or 
                     myBase:FindFirstChild("SpawnLocation", true) or
                     myBase:FindFirstChild("BaseSpawn", true) or
                     myBase.PrimaryPart
        
        if dest then
            -- Se for um modelo, tenta pegar o PrimaryPart
            if dest:IsA("Model") then
                dest = dest.PrimaryPart or dest:FindFirstChildWhichIsA("BasePart")
            end
            
            if dest and dest:IsA("BasePart") then
                hrp.CFrame = dest.CFrame + Vector3.new(0, 4, 0)
                showNotification("✅ Teleportado para sua base!", false)
                return
            end
        end
        
        -- Fallback: teleporta para o centro da base
        local baseHRP = myBase:FindFirstChild("HumanoidRootPart") or myBase:FindFirstChildWhichIsA("BasePart")
        if baseHRP then
            hrp.CFrame = baseHRP.CFrame + Vector3.new(0, 4, 0)
            showNotification("✅ Teleportado para sua base!", false)
            return
        end
        
        showNotification("❌ Ponto de teleporte não encontrado na sua base!", true)
    else
        showNotification("❌ Sua base não foi encontrada!", true)
    end
end

